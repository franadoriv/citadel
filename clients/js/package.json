{
  "name": "@citadel/client",
  "version": "0.1.0",
  "description": "Citadel realtime client SDK for browser WebSocket/WebTransport and Node WebSocket.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js"
    },
    "./protocol": "./src/protocol.js",
    "./envelope": "./src/envelope.js",
    "./client": "./src/client.js",
    "./chat": {
      "types": "./chat.d.ts",
      "import": "./src/chat.js"
    },
    "./networkpeer": "./src/networkpeer.js"
  },
  "files": [
    "src/",
    "index.d.ts",
    "chat.d.ts",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "node scripts/build-release.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  },
  "keywords": [
    "citadel",
    "game-server",
    "realtime",
    "websocket",
    "multiplayer"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "lossless-json": "4.3.1"
  }
}
