{
  "abi_version": 3,
  "wire": {
    "KIND_POSITION": 1,
    "KIND_PEER_POSITION": 2,
    "KIND_RPC_REQUEST": 3,
    "KIND_RPC_RESPONSE": 4,
    "KIND_AUTH": 5,
    "KIND_AUTH_RESULT": 6,
    "AUTH_STATUS_AUTHENTICATED": 0,
    "AUTH_STATUS_GUEST": 1,
    "AUTH_STATUS_REJECTED": 2,
    "AUTH_REASON_AUTH_FAILED": 0,
    "AUTH_REASON_AUTH_REQUIRED": 1,
    "AUTH_REASON_PROTOCOL": 2,
    "RPC_STATUS_OK": 0,
    "RPC_STATUS_ERROR": 1,
    "RPC_REQUEST_ID_BYTES": 8,
    "RPC_METHOD_LEN_BYTES": 2,
    "SENDER_ID_BYTES": 8,
    "POSITION_BYTES": 8,
    "KIND_TSYNC_HELLO": 7,
    "KIND_TSYNC_SNAPSHOT": 8,
    "KIND_TSYNC_INPUT": 9,
    "KIND_TSYNC_ACK": 10,
    "KIND_TSYNC_ROLE": 11,
    "KIND_TSYNC_REWIND": 12,
    "KIND_TSYNC_V2_HELLO": 29,
    "KIND_TSYNC_V2_SNAPSHOT": 30,
    "KIND_TSYNC_V2_INPUT": 31,
    "KIND_REP_DELTA": 13,
    "KIND_REP_ACK": 14,
    "KIND_REP_SCHEMA": 15,
    "KIND_NA_PRESENCE": 16,
    "KIND_NA_SPAWN": 17,
    "KIND_NA_SPAWN_BATCH": 18,
    "KIND_NA_DESPAWN": 19,
    "KIND_NA_STATE": 20,
    "KIND_ROOM_CREATE": 21,
    "KIND_ROOM_JOIN": 22,
    "KIND_ROOM_JOINED": 23,
    "KIND_ROOM_LEAVE": 24,
    "KIND_ROOM_MAP_READY": 25,
    "KIND_ROOM_REJECT": 33,
    "KIND_MATCHMAKER_MATCHED": 26,
    "KIND_NOTIFICATION": 27,
    "KIND_CHAT_EVENT": 28,
    "KIND_MATCH_CLOSED": 32,
    "KIND_DIAG_SERVER_TIME": 34,
    "KIND_DIAG_CAPABILITIES": 35,
    "KIND_DIAG_CLOCK_SYNC": 36,
    "KIND_DIAG_START": 37,
    "KIND_DIAG_FLUSH": 38,
    "KIND_DIAG_STATUS": 39,
    "KIND_MATCH_INPUT": 41,
    "KIND_MATCH_INPUT_ACK": 42,
    "MATCH_CLOSE_REASON_SERVER_ERROR": 0,
    "MATCH_CLOSED_BYTES": 10,
    "TSYNC_KIND_MIN": 7,
    "TSYNC_KIND_MAX": 12,
    "REP_KIND_MIN": 13,
    "REP_KIND_MAX": 15,
    "NA_KIND_MIN": 16,
    "NA_KIND_MAX": 20,
    "ROOM_KIND_MIN": 21,
    "ROOM_KIND_MAX": 25,
    "MATCHMAKER_KIND_MIN": 26,
    "MATCHMAKER_KIND_MAX": 26,
    "NOTIFICATION_KIND_MIN": 27,
    "NOTIFICATION_KIND_MAX": 27,
    "CHAT_KIND_MIN": 28,
    "CHAT_KIND_MAX": 28,
    "ACK_HISTORY_BITS": 32,
    "SCHEMA_HASH_BYTES": 16
  },
  "netcode": {
    "bit_order": "msb-first-within-byte",
    "codec_ids": {
      "BOOL": 1,
      "SCALAR_QUANT": 2,
      "VECTOR3_QUANT": 3,
      "QUAT_SMALLEST3_9": 4,
      "QUAT_SMALLEST3_10": 5,
      "QUAT_SMALLEST3_15": 6
    },
    "quantization": {
      "canonical_unit": "cm",
      "formula": "levels = round((max-min)*values_per_unit); bits = ceil_log2(levels+1); inclusive endpoints",
      "rounding": "floor(x + 0.5) in f64",
      "saturation": "encode clamps to bounds (never wraps); decode rejects out-of-range codes",
      "default_world_bounds": {
        "min": [
          -262144.0,
          -262144.0,
          -32768.0
        ],
        "max": [
          262144.0,
          262144.0,
          32768.0
        ],
        "values_per_unit": 8
      },
      "quat_modes": {
        "Bits9": 9,
        "Bits10": 10,
        "Bits15": 15
      }
    },
    "schema_hash": {
      "algorithm": "blake3-128/citadel.schema.v1",
      "bytes": 16
    },
    "baseline": {
      "token": "server-issued monotonic nonzero u64 (0 reserved for none/is_full)",
      "ack_history_bits": 32
    },
    "netpeer": {
      "object_id_bits": 32,
      "layout_version_bits": 32,
      "varint": "bit-packed LEB128, [continuation:1][data:7] groups, least-significant first, canonical (overlong rejected)",
      "varint_max_groups": 10,
      "result_id": "server-issued nonzero token every bunch establishes; acks name it",
      "base_id": "token diffed against; 0 iff is_full (no base)",
      "collections": "FastArray-style keyed delta: rep_id {index:u32, gen:u32} + rep_key u64; removed/added/changed; duplicate rep_ids rejected",
      "caps": {
        "max_bunches_per_envelope": 4096,
        "max_collection_ops": 65536,
        "max_bytes_field_len": 1048576,
        "max_envelope_alloc": 4194304,
        "max_ack_entries": 8192,
        "max_schema_entries": 8192
      }
    },
    "test_vectors": "crates/citadel-wire/tests/wire_vectors.json"
  },
  "http": {
    "device_auth_path": "/v1/auth/device",
    "custom_auth_path": "/v1/auth/custom",
    "email_auth_path": "/v1/auth/email",
    "auth_request_fields": [
      "id",
      "create",
      "username",
      "display_name",
      "metadata"
    ],
    "email_auth_request_fields": [
      "email",
      "password",
      "create",
      "username",
      "display_name",
      "metadata"
    ],
    "auth_response_fields": [
      "token",
      "refresh_token",
      "user_id",
      "username",
      "created"
    ]
  }
}
